        .text-size-medium { font-size: 1.125rem; line-height: 1.6; }
        .text-size-regular { font-size: 1rem; line-height: 1.7; }
        .text-size-small { font-size: 0.875rem; line-height: 1.8; }

        .text-style-allcaps { text-transform: uppercase; }
        .text-color-green { color: var(--color-primary); }
        .text-color-blue { color: var(--color-secondary); }
        .text-color-white { color: var(--color-text-light); }
        .text-color-dark { color: var(--color-text-dark); }
        .text-align-center { text-align: center; }
        .text-weight-bold { font-weight: 700; }
        .text-weight-medium { font-weight: 500; }


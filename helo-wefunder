        .padding-section-small { padding-top: 4rem; padding-bottom: 4rem; }
        .padding-section-medium { padding-top: 6rem; padding-bottom: 6rem; }
        .padding-section-large { padding-top: 8rem; padding-bottom: 8rem; }
        .padding-section-xlarge { padding-top: 10rem; padding-bottom: 10rem; }

            --color-secondary: #3B82F6; /* Blue from EFG site */
            --color-dark: #1F2937; /* Dark background */
            --color-text-light: #F9FAFB; /* Light text */
            --color-text-dark: #111827; /* Dark text */
            --gradient-start: #3B82F6; /* Blue for gradient */
            --gradient-end: #34D399; /* Green for gradient */
        }

        body {
            font-family: 'Inter', sans-serif; /* Default font, can be overridden by specific elements */
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            background-color: var(--color-dark);
            color: var(--color-text-light);
            overflow-x: hidden; /* Prevent horizontal scrolling */
        }

        .page-wrapper {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .main-wrapper {
            flex-grow: 1;
        }

        /* Gradient Button styles */
        .button-main.gradient {
            background-image: linear-gradient(to right, var(--gradient-start), var(--gradient-end));
            border: none;
            color: white;
            padding: 0.75rem 1.5rem;
            border-radius: 9999px;
            font-weight: 600;
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        .button-main.gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 10px rgba(0, 0, 0, 0.2);
        }

        /* Separator styles */
        .separator-small {
            width: 3rem;
            height: 0.25rem;
            background-color: var(--color-primary);
            border-radius: 9999px;
            margin-top: 1rem;
            margin-bottom: 1rem;
        }
        .separator-large {
            width: 6rem;
            height: 0.35rem;
            background-color: var(--color-primary);
            border-radius: 9999px;
            margin-top: 1.5rem;
            margin-bottom: 1.5rem;
        }
        .separator-vertical {
            width: 2px;
            height: 80%; /* Adjust height as needed */
            background-color: rgba(255, 255, 255, 0.2);
            border-radius: 9999px;
            margin: 0 2rem;
            display: flex; /* Make it a flex item */
            align-self: center; /* Center vertically in flex container */
        }
        @media (max-width: 767px) {
            .separator-vertical {
                width: 80%;
                height: 2px;
                margin: 2rem 0;
            }
        }

        /* Background Video Styles */
        .section-bg-video {
            position: relative;
            overflow: hidden;
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 60vh; /* Minimum height for visibility */
            padding: 4rem 0; /* Adjust padding as needed */
        }
        .section-bg-video video {
            position: absolute;
            top: 50%;
            left: 50%;
            min-width: 100%;
            min-height: 100%;
            width: auto;
            height: auto;
            z-index: -1;
            transform: translate(-50%, -50%);
            background-size: cover;
            filter: brightness(0.6); /* Darken video */
        }

        /* Generic image/video embed aspect ratio */
        .w-embed-video-container {
            position: relative;
            width: 100%;
            padding-top: 56.25%; /* 16:9 Aspect Ratio */
        }
        .w-embed-video-container iframe,
        .w-embed-video-container video {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }

        /* Specific section background images/patterns */
        .hero-noise {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0.1;
            mix-blend-mode: overlay;
            pointer-events: none;
            object-fit: cover;
            z-index: 0;
